# AI Service (FastAPI)
AI_SERVICE_PORT=5000
ENV=development

# OCR (PaddleOCR)
OCR_LANG=korean
OCR_USE_GPU=false

# ML 이상거래탐지 모델
XGBOOST_MODEL_PATH=./mlModel/artifacts/xgboost_model.joblib

# 메인 API 서버 콜백 (검증 결과 전달)
BACKEND_CALLBACK_URL=http://localhost:4000/api/document/verification-callback
BACKEND_CALLBACK_API_KEY=changeme

# LLM (F4 리포트 산문 요약 / F1 구조화 추출)
# LLM_PROVIDER 를 비우거나 template 로 두면 외부 호출 없이 규칙 기반 요약을 쓴다.
# 키가 없거나 changeme 이면 자동으로 템플릿으로 떨어지므로, 키 없이도 리포트는 나온다.
LLM_PROVIDER=template
GEMINI_API_KEY=changeme
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=600
LLM_TIMEOUT=20
