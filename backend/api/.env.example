# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ebl_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ebl_db

# Auth / JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# PKI 전자서명
PKI_CERT_PATH=./certs/cert.pem
PKI_PRIVATE_KEY_PATH=./certs/private-key.pem

# Blockchain (contract 연동)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/your-project-id
BLOCKCHAIN_PRIVATE_KEY=changeme-server-wallet-private-key
CONTRACT_ADDRESS_EBL=0x0000000000000000000000000000000000000000

# IPFS / Pinata
PINATA_API_KEY=changeme
PINATA_API_SECRET=changeme

# AI Service 연동
AI_SERVICE_BASE_URL=http://localhost:5000

# UNI-PASS (관세청 통관 API)
UNIPASS_API_KEY=changeme
UNIPASS_API_URL=https://unipass.customs.go.kr/openapi

# 이메일 알림 (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
EMAIL_FROM=no-reply@example.com
