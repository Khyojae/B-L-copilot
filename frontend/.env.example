# API 서버
VITE_API_BASE_URL=http://localhost:4000/api

# aiService (F1 인테이크 · F3 하자검증 · F4 리포트) — FastAPI
#
# 개발 중에는 비워두세요. 기본값 `/ai-api` 가 Vite 개발 프록시를 타고,
# 프록시가 아래 AI_SERVICE_ORIGIN 으로 전달합니다 (CORS 회피용).
# 나중에 게이트웨이가 앞에 서면 VITE_API_BASE_URL 로 합칩니다.
# VITE_AI_API_BASE_URL=/ai-api

# aiService 가 실제로 떠 있는 곳. Vite 프록시만 씁니다(브라우저에 노출 안 됨).
# 포트 5000 은 백엔드 문서가 정한 값입니다 (docs/ai-service/api-spec.md "Base URL").
# 백엔드 실행: cd aiService && .venv\Scripts\python -m uvicorn api.main:app --port 5000
AI_SERVICE_ORIGIN=http://127.0.0.1:5000

# 블록체인 / 지갑 연동 (MetaMask)
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS_EBL=0x0000000000000000000000000000000000000000

# 통관 상태 조회 (표시용, 실제 API 키는 백엔드에서만 사용)
VITE_CUSTOMS_STATUS_POLL_INTERVAL_MS=30000
